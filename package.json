    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "marked": "^18.0.4",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
